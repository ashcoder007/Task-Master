{
  "name": "team-task-management-saas",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "prisma:deploy": "npm run prisma:deploy -w backend",
    "seed": "npm run seed -w backend",
    "postinstall": "npm run prisma:generate -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
